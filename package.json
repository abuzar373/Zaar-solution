{
  "name": "abuzar-software-solutions",
  "version": "1.0.0",
  "private": true,
  "description": "Abuzar Software Solutions — full stack software house website with admin dashboard (Next.js, PostgreSQL, Drizzle ORM).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup-db.mjs",
    "db:push": "drizzle-kit push",
    "db:seed": "node scripts/seed.mjs",
    "db:studio": "drizzle-kit studio",
    "db:reset": "drizzle-kit push --force && node scripts/seed.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
