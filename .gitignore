# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# next.js
/.next/
/out/
next-env.d.ts

# production
/build
/dist

# misc
.DS_Store
*.pem
Thumbs.db

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (NEVER commit real secrets)
.env
.env*.local
.env.production
!.env.example

# vercel / typescript
.vercel
*.tsbuildinfo

# drizzle migration output
/drizzle/meta

# user uploaded images - keep the folder, ignore the contents
/uploads/*
!/uploads/.gitkeep

# editor
.idea/
.vscode/*
!.vscode/extensions.json
