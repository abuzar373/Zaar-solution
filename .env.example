# Supabase PostgreSQL connection string.
# Use the Transaction Pooler URL from Supabase for Vercel/serverless deployments.
# Example: postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Used to sign admin HTTP-only session cookies.
AUTH_SECRET=replace-with-a-long-random-secret

# First-login admin bootstrap. Set these in Vercel before using /login.
ADMIN_NAME=Abuzar Ahmed
ADMIN_EMAIL=admin@abuzarsoftware.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public bucket used for admin-uploaded project/service/team images.
SUPABASE_STORAGE_BUCKET=uploads
