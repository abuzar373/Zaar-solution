# ===================================================================
#  Copy this file to `.env`  ->  cp .env.example .env
#
#  ONLY TWO VARIABLES ARE REQUIRED.
#  Leave everything else out unless you really need it.
# ===================================================================

# 1. REQUIRED — PostgreSQL connection string
#
#    Local (matches docker-compose.yml):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
#
#    Supabase (Vercel) — use the TRANSACTION POOLER url, port 6543:
#    DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
#
#    Supabase (running migrations from your PC) — SESSION pooler, port 5432:
#    DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres


# 2. REQUIRED — secret used to sign admin session cookies
#    Generate one with:  openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string


# ===================================================================
#  OPTIONAL — custom admin account created on first run.
#
#  !! IMPORTANT !!
#  Do NOT add these as EMPTY values. An empty ADMIN_EMAIL used to create
#  an admin with a blank email that nobody could log in as. If you do not
#  want to customise them, DELETE these lines entirely.
#
#  Defaults when omitted:
#    email    admin@abuzarsoftware.com
#    password admin123
# ===================================================================
# ADMIN_NAME=Your Name
# ADMIN_EMAIL=you@yourdomain.com
# ADMIN_PASSWORD=your-secure-password


# ===================================================================
#  OPTIONAL — Supabase Storage, for image uploads that survive on Vercel.
#  Without these the admin image fields still accept a direct image URL.
# ===================================================================
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=uploads
