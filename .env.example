# ---------------------------------------------------------------
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
# ---------------------------------------------------------------

# PostgreSQL connection string.
# Local (matches docker-compose.yml):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Neon / Supabase / Render example (note the required sslmode):
# DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Secret used to sign admin session cookies.
# Generate a strong one with:  openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Admin account created by `node scripts/seed.mjs`
ADMIN_NAME=Abuzar Ahmed
ADMIN_EMAIL=admin@abuzarsoftware.com
ADMIN_PASSWORD=admin123
